/* Structure comes from the chosen layout; only bounded dimensions vary by seed. */

/* Mirror the photo and text regions, while preserving a stable reading order. */
.card { display: flex; flex-direction: column; padding: {{ variation.margin }}px; font-size: {{ variation.font_size }}px; }
.title-section { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); align-items: start; gap: 24px; }
.title-section h1 { font-size: {{ variation.font_size * 1.5 }}px; }
.title-section h2 { font-size: {{ variation.font_size * 1.2 }}px; text-align: right; }
.card-header { margin-bottom: {{ variation.header_gap }}px; }
.card-body { display: grid; grid-template-columns: var(--portrait-columns); gap: {{ variation.column_gap }}px; align-items: start; }
.photo-section { grid-column: var(--portrait-column); grid-row: 1; }
.main-photo { width: 378px; height: 510px; object-fit: cover; }
.data-section { grid-column: var(--data-column); grid-row: 1; display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: {{ variation.field_gap }}px; min-height: 510px; position: relative; isolation: isolate; }
.name-holder { display: grid; grid-template-columns: minmax(0, 1fr); gap: {{ variation.field_gap }}px; }
.data-group, .key-curp { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; align-items: start; }
.data-item { margin: 0; min-width: 0; }
.data-item p { margin: 3px 0 0; }
.data-item label { margin-bottom: 3px; font-size: {{ variation.label_size }}px; }
.data-section > :not(.small-photo-container) { position: relative; z-index: 1; }

/* An opposite-side watermark, behind every field rather than over the portrait. */
.small-photo-container { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
.small-photo { top: auto; bottom: 0; right: var(--watermark-right); left: var(--watermark-left); width: 132px; height: 170px; object-fit: cover; opacity: {{ variation.watermark_opacity }}; filter: grayscale(100%); }

.bottom-row .state:first-child { order: {{ variation.dates_reversed }}; }
.bottom-row .state:last-child { order: {{ 1 - variation.dates_reversed }}; }
