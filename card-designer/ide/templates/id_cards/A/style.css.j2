/* A: a full-height portrait and a balanced identity column. */
.card-body { flex: 1; min-height: 0; display: grid; grid-template-columns: var(--portrait-columns); gap: {{ variation.column_gap }}px; }
.photo-section { grid-column: var(--portrait-column); grid-row: 1; }
.main-photo { width: 100%; height: 100%; }
.data-section { grid-column: var(--data-column); grid-row: 1; display: grid; align-content: space-between; gap: {{ variation.field_gap }}px; position: relative; isolation: isolate; }
.name-holder { display: grid; gap: 24px; }
.data-section > :not(.small-photo-container) { position: relative; z-index: 1; }
.small-photo-container { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
.small-photo { position: absolute; bottom: 0; right: var(--watermark-right); left: var(--watermark-left); width: 132px; height: 170px; object-fit: cover; opacity: {{ variation.watermark_opacity }}; filter: grayscale(100%); }
