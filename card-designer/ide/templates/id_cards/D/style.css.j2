.identity-body { flex: 1; min-height: 0; display: grid; grid-template-columns: var(--portrait-columns); gap: {{ variation.column_gap }}px; }
.photo-section { grid-column: var(--portrait-column); grid-row: 1; }
.main-photo { width: 100%; height: 100%; }
.identity-details { grid-column: var(--data-column); grid-row: 1; min-width: 0; }
.title-section { grid-template-columns: minmax(0, 1fr); gap: 10px; }.title-section h2 { text-align: left; }
.photo-section { display: grid; grid-template-rows: auto auto auto auto; align-content: space-between; gap: 28px; }
.main-photo { height: 420px; flex-shrink: 0; }
.photo-section .physical-grid { grid-template-columns: minmax(0, 1fr); gap: 24px; }
.identity-details { grid-template-columns: minmax(0, 1fr); align-content: space-between; }
.dates { grid-template-columns: minmax(0, 1fr); gap: 28px; }
