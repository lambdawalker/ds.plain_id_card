.back-body { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 20px; }
.code-panel { display: grid; grid-template-columns: minmax(0, 1fr) 128px; gap: 32px; align-items: center; order: var(--codes-order); }
.pdf417 { width: 850px; height: 120px; }.qrcode { width: 128px; height: 128px; }
.back-details { order: var(--details-order); flex: 1; align-content: space-between; }
.slim-barcode { width: 700px; height: 40px; align-self: center; flex-shrink: 0; }
