.rail-body {
  display: grid;
  grid-template-columns: var(--rail-columns);
  gap: 32px;
  flex: 1;
  min-height: 0;
}
.barcode-rail {
  position: relative;
  grid-column: var(--rail-column);
  grid-row: 1;
}
.barcode-rail .barcode {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 580px;
  max-width: none;
  height: 100px;
  transform: translate(-50%, -50%) rotate(90deg);
}
.rail-content {
  grid-column: var(--content-column);
  grid-row: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.rail-content > .field-grid {
  flex: 1;
  align-content: space-between;
}
.code-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 160px;
  gap: 28px;
  align-items: center;
}
.pdf417 {
  width: 720px;
  height: 135px;
}
.qrcode { width: 160px; height: 160px; }
