/* Structural placement is defined by the selected layout file. */
.card { width: 100%; height: 100%; padding: {{ variation.margin }}px; font-size: {{ variation.font_size }}px; display: flex; flex-direction: column; gap: {{ variation.header_gap }}px; }
.card-header { margin: 0; flex-shrink: 0; }
.title-section { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 24px; align-items: start; }
.title-section h1 { font-size: {{ variation.font_size * 1.5 }}px; margin: 0; }
.title-section h2 { font-size: {{ variation.font_size * 1.15 }}px; text-align: right; margin: 0; }
.data-item { margin: 0; min-width: 0; overflow-wrap: anywhere; }
.data-item p { margin: 3px 0 0; line-height: 1.2; }
.data-item label { font-size: {{ variation.label_size }}px; margin: 0; }
.field-grid, .dates { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: {{ variation.field_gap }}px 24px; align-content: start; }
.full { grid-column: 1 / -1; }
.physical-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
.dates .issued { order: {{ variation.dates_reversed }}; }
.dates .expires { order: {{ 1 - variation.dates_reversed }}; }
.code-image { display: block; object-fit: contain; max-width: 100%; }

.rail-body { display: grid; grid-template-columns: var(--rail-columns); gap: 28px; flex: 1; min-height: 0; }.barcode-rail { position: relative; grid-column: var(--rail-column); grid-row: 1; min-height: 480px; }.barcode-rail .barcode { position: absolute; top: 50%; left: 50%; width: 450px; max-width: none; height: 90px; transform: translate(-50%, -50%) rotate(90deg); }.rail-content { grid-column: var(--content-column); grid-row: 1; min-width: 0; display: flex; flex-direction: column; gap: 18px; }.code-panel { display: grid; grid-template-columns: minmax(0, 1fr) 140px; gap: 24px; align-items: center; }.pdf417 { width: 500px; height: 100px; }.qrcode { width: 140px; height: 140px; }
