<div class="card bundle-card">
  <header class="card-header">
    <div class="title-section">
      <h1>{{ common.get('card_title') or identity.document_type or 'IDENTITY CARD' }}</h1>
      <h2>{{ common.get('issuer') or identity.issuing_authority or 'SPECIMEN' }}</h2>
    </div>
  </header>
  <main class="identity-body">
    <div class="photo-section">
      <img
        class="main-photo"
        src="{{ assets.photo }}"
        data-class="photo"
        alt="Portrait"
      />
    </div>
    <div class="identity-details field-grid">
      <div class="data-item name full">
        <label>NAME</label>
        <p>{{ identity.full_name or '—' }}</p>
      </div>
      <div class="data-item birth">
        <label>DATE OF BIRTH</label>
        <p>{{ identity.birth_date or '—' }}</p>
      </div>
      <div class="data-item sex">
        <label>SEX</label>
        <p>{{ identity.sex or '—' }}</p>
      </div>
      <div class="data-item address full">
        <label>ADDRESS</label>
        <p>{{ identity.address_line1 or '—' }}</p>
        {% if identity.address_line2 %}
        <p>{{ identity.address_line2 }}</p>
        {% endif %}
      </div>
      <div class="data-item ">
        <label>DOCUMENT NUMBER</label>
        <p>{{ identity.document_number or '—' }}</p>
      </div>
      <div class="data-item ">
        <label>NATIONALITY</label>
        <p>{{ identity.nationality or '—' }}</p>
      </div>
      <div class="physical-grid full">
        <div class="data-item ">
          <label>HEIGHT</label>
          <p>{{ identity.height or '—' }}</p>
        </div>
        <div class="data-item ">
          <label>EYES</label>
          <p>{{ identity.eye_color or '—' }}</p>
        </div>
        <div class="data-item ">
          <label>BLOOD TYPE</label>
          <p>{{ identity.blood_type or '—' }}</p>
        </div>
      </div>
      <div class="dates full">
        <div class="data-item issued">
          <label>ISSUED</label>
          <p>{{ identity.issue_date or '—' }}</p>
        </div>
        <div class="data-item expires">
          <label>EXPIRES</label>
          <p>{{ identity.expiry_date or '—' }}</p>
        </div>
      </div>
    </div>
  </main>
</div>
