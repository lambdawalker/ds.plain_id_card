.identity-body { flex: 1; min-height: 0; display: grid; grid-template-columns: var(--portrait-columns); gap: {{ variation.column_gap }}px; }
.photo-section { grid-column: var(--portrait-column); grid-row: 1; }
.main-photo { width: 100%; height: 100%; }
.identity-details { grid-column: var(--data-column); grid-row: 1; min-width: 0; }
.identity-details { display: flex; flex-direction: column; gap: 18px; }
.identity-details > .field-grid { flex: 1; align-content: space-between; }
.verification { display: flex; align-items: center; gap: 18px; }
.verification .qrcode { width: 100px; height: 100px; flex-shrink: 0; }
.mrz-text { font: 18px/1.2 monospace; white-space: pre-wrap; overflow-wrap: anywhere; min-width: 0; margin: 0; }
.footer-barcode { width: 750px; height: 55px; align-self: center; flex-shrink: 0; }
