<div class="card">
        <header>
            <span class="small-text">{{ gen.text.sentence((3,6)) }}</span>
            {%- if gen.random.boolean() %}
            <img class="slim-barcode" src="{{ assets.slim_barcode }}" data-class="barcode" alt="Barcode">
            {% endif %}
        </header>

        <main>
            {%- if gen.random.boolean() %}
                <p class="small-text">{{ gen.text.sentence((3,7)) }}</p>
            {% endif -%}
            <div class="photo-container">
                {%- if gen.random.boolean() %}
                    <img class="photo" src="{{ assets.photo }}" data-class="photo" alt="Photo">
                {% else %}
                    {% for i in range([1,2,3] | random) %}
                        <img class="qrcode" src="{{ assets.qrcode }}" data-class="qrcode" alt="qrcode">
                    {% endfor %}
                {% endif -%}

                <div class="photo-text">
                    {% if gen.random.boolean() %}
                        {% for i in range([2, 3] | random) %}
                            <p class="small-text">{{ gen.text.sentence((6,10)) }}</p>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </main>
        <p class="sep-line">
            <span class="embedded">{{ gen.text.word((1,2)) }}</span>
            {{ gen.text.sentence((6,8)) }}
        </p>
        <footer>
            {%- if gen.random.boolean() %}
            {% else %}
                <p data-class="mrz-text" class="mrz-text">{{ gen.random.mrz() | e }}</p>
                <img class="barcode" src="{{ assets.barcode }}" data-class="barcode" alt="barcode">
            {% endif %}
        </footer>
    </div>
