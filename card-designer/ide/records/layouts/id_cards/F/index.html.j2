<div class="card">
  <header class="card-header">
    <div class="title-section">
      <h1>{{ common.get('card_title') or identity.document_type or 'IDENTITY CARD' }}</h1>
      <h2>{{ common.get('issuer') or identity.issuing_authority or 'SPECIMEN' }}</h2>
    </div>
  </header>
  <main class="rail-body">
    <div class="barcode-rail">
      <img
        class="barcode code-image"
        src="{{ assets.barcode }}"
        data-class="barcode"
        alt="Barcode"
      />
    </div>
    <div class="rail-content">
      <div class="field-grid">
        <div class="card-field field-name field-full">
          <span class="field-label">NAME</span>
          <p>{{ identity.full_name or '—' }}</p>
        </div>
        <div class="card-field">
          <span class="field-label">DOCUMENT NUMBER</span>
          <p>{{ identity.document_number or '—' }}</p>
        </div>
        <div class="card-field">
          <span class="field-label">NATIONALITY</span>
          <p>{{ identity.nationality or '—' }}</p>
        </div>
        <div class="card-field field-address field-full">
          <span class="field-label">ADDRESS</span>
          <p>{{ identity.address_line1 or '—' }}</p>
          {% if identity.address_line2 %}
          <p>{{ identity.address_line2 }}</p>
          {% endif %}
        </div>
        <div class="card-field">
          <span class="field-label">EMAIL</span>
          <p>{{ identity.email or '—' }}</p>
        </div>
        <div class="card-field">
          <span class="field-label">PHONE</span>
          <p>{{ identity.phone_number or '—' }}</p>
        </div>
      </div>
      <div class="code-panel">
        <img
          class="pdf417 code-image"
          src="{{ assets.pdf417 }}"
          data-class="pdf417"
          alt="PDF417"
        /><img
          class="qrcode code-image"
          src="{{ assets.qrcode }}"
          data-class="qrcode"
          alt="QR code"
        />
      </div>
      <div class="field-pair validity-dates field-full">
        <div class="card-field field-issued">
          <span class="field-label">ISSUED</span>
          <p>{{ identity.issue_date or '—' }}</p>
        </div>
        <div class="card-field field-expires">
          <span class="field-label">EXPIRES</span>
          <p>{{ identity.expiry_date or '—' }}</p>
        </div>
      </div>
    </div>
  </main>
</div>
