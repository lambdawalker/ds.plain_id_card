.title-section {
  grid-template-columns: minmax(0, 1fr);
  gap: 10px;
}
.title-section h2 { text-align: left; }
.photo-section {
  display: grid;
  grid-template-rows: auto auto auto auto;
  align-content: space-between;
  gap: 28px;
}
.identity-body { --portrait-height: 420px; }
.photo-section .physical-grid {
  grid-template-columns: minmax(0, 1fr);
  gap: 24px;
}
.identity-details {
  grid-template-columns: minmax(0, 1fr);
  align-content: space-between;
}
.validity-dates {
  grid-template-columns: minmax(0, 1fr);
  gap: 28px;
}
