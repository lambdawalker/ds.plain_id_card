.title-section {
  grid-template-columns: minmax(0, 1fr);
  gap: 10px;
}
.title-section h2 { text-align: left; }
.identity-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24px;
  min-height: 0;
}
.photo-section {
  order: var(--photo-order);
  align-self: center;
  flex-shrink: 0;
}
.identity-body .main-photo {
  width: 320px;
  height: 350px;
}
.identity-details {
  order: var(--details-order);
  flex: 1;
  align-content: space-between;
}
